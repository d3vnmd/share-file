# Copy to .env (Node.js) or .dev.vars (wrangler dev) and fill in.

# "github" (default) or "memory" (local testing only, data is lost on restart)
STORAGE=github

# Fine-grained personal access token with ONLY:
#   Repository access: the storage repo   Permissions: Contents = Read and write
GITHUB_TOKEN=
# Storage repository, preferably PRIVATE and separate from the code: owner/name
GITHUB_REPO=your-user/share-file-storage
GITHUB_BRANCH=main

# Required. Long random secret; all stored files are encrypted with keys derived
# from it. Generate with: npm run keygen   (never change it, or old links break)
MASTER_KEY=

# Optional: require this key to upload (strongly recommended for public sites)
UPLOAD_TOKEN=

# Optional: public URL used in generated links (e.g. https://f.example.com)
PUBLIC_URL=
# Set to true when running behind a reverse proxy (nginx, Render, Railway, ...)
TRUST_PROXY=false

# Limits
MAX_FILE_SIZE_MB=20
ID_LENGTH=7
DEFAULT_EXPIRY=1d
MAX_EXPIRY=30d
RATE_LIMIT_UPLOADS=10
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_NOT_FOUND=20

PORT=3000
